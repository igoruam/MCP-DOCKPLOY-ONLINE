# Server-side options only. User credentials are NEVER configured here.
PORT=3000
PUBLIC_URL=https://mcp.example.com          # public URL of this server (OAuth metadata)
MCP_SECRET=                                  # required: `openssl rand -hex 32`; rotating it signs everyone out
# OAUTH_ALLOWED_REDIRECT_HOSTS=example.com    # extra hosts allowed as OAuth redirect (defaults: Claude, ChatGPT, localhost)
# DOKPLOY_ALLOWED_HOSTS=dokploy.example.com   # restrict which Dokploy hosts can be reached
# DOKPLOY_TOOL_PRESET=all                     # all | minimal | core | deploy | databases | git
# DOKPLOY_ALLOW_HTTP=1                        # allow http:// Dokploy URLs (not recommended)
# DOKPLOY_ALLOW_PRIVATE_HOSTS=1               # allow private/LAN Dokploy hosts (self-hosting only)
# DOKPLOY_REDACT_ENV=true
